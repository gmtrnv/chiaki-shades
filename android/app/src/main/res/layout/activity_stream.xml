<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainStreamLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".stream.StreamActivity"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- console mode: the shell behind the video and the touch pad -->
    <com.metallic.chiaki.touchcontrols.console.ShellView
        android:id="@+id/consoleShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.metallic.chiaki.stream.AspectRatioFrameLayout
        android:id="@+id/aspectRatioLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
        <!-- video, drawn by our ShaderRenderer -->
        <android.opengl.GLSurfaceView
            android:id="@+id/videoSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.metallic.chiaki.touchcontrols.TouchpadView
            android:id="@+id/streamTouchpadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:drawableIdle="@android:color/transparent"
            app:drawablePressed="@android:color/transparent" />
    </com.metallic.chiaki.stream.AspectRatioFrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <fragment
        android:id="@+id/controlsFragment"
        android:name="com.metallic.chiaki.touchcontrols.DefaultTouchControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.metallic.chiaki.touchcontrols.console.ConsolePadView
        android:id="@+id/consolePad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- statistics over the game (Settings, or long press on ✕); never takes touches -->
    <com.metallic.chiaki.stream.StatsOverlayView
        android:id="@+id/statsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/overlayBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/stream_overlay_background"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="false">

            <!-- on-screen (touch) controls on/off -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/onScreenControlsButton"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checkable="true"
                android:contentDescription="@string/on_screen_controls"
                app:icon="@drawable/ic_gamepad"
                app:iconTint="@color/stream_material_button_icon_tint"
                app:strokeColor="@color/stream_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- sound and vibration: tap = total silence and back, checked = something plays; long press opens the panel -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/volumeButton"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checkable="true"
                android:contentDescription="@string/stream_volume_button"
                app:icon="@drawable/ic_sound_vibration"
                app:iconTint="@color/stream_material_button_icon_tint"
                app:strokeColor="@color/stream_text"
                app:layout_constraintStart_toEndOf="@id/onScreenControlsButton"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- gyroscope as a stick: checked = on, tap pauses, long press recentres. Only shown when the option is on -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/gyroButton"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checkable="true"
                android:checked="true"
                android:visibility="gone"
                android:contentDescription="@string/gyro_button_description"
                app:icon="@drawable/ic_gyro"
                app:iconTint="@color/stream_material_button_icon_tint"
                app:strokeColor="@color/stream_text"
                app:layout_constraintStart_toEndOf="@id/volumeButton"
                app:layout_constraintBottom_toBottomOf="parent"/>


            <!-- effects that work on top of any display mode -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/effectsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/displayModeToggle"
                app:singleSelection="false">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/effect_color_button"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/effect_color"
                    app:icon="@drawable/ic_effect_color"
                    app:iconTint="@color/stream_material_button_icon_tint"
                    app:strokeColor="@color/stream_text"/>
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/effect_hq_button"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/effect_hq"
                    android:text="HQ"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/stream_material_button_icon_tint"
                    app:strokeColor="@color/stream_text"/>
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/effect_deband_button"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/effect_deband"
                    app:icon="@drawable/ic_effect_deband"
                    app:iconTint="@color/stream_material_button_icon_tint"
                    app:strokeColor="@color/stream_text"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/displayModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/overlayCloseButton"
                app:singleSelection="true"
                app:selectionRequired="false">

                <!-- no button checked = Normal (fit): every bar button toggles the same way -->
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/display_mode_zoom_button"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_display_zoom"
                    app:iconTint="@color/stream_material_button_icon_tint"
                    app:strokeColor="@color/stream_text"/>
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/display_mode_stretch_button"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_display_stretch"
                    app:iconTint="@color/stream_material_button_icon_tint"
                    app:strokeColor="@color/stream_text"/>
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/display_mode_optical_button"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/display_mode_optical"
                    app:icon="@drawable/ic_display_optical"
                    app:iconTint="@color/stream_material_button_icon_tint"
                    app:strokeColor="@color/stream_text"/>
                <!-- the video where the layout puts it, over the shell (or black) -->
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:id="@+id/display_mode_shell_button"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/display_mode_shell"
                    app:icon="@drawable/ic_display_shell"
                    app:iconTint="@color/stream_material_button_icon_tint"
                    app:strokeColor="@color/stream_text"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

            <ImageButton
                android:id="@+id/overlayCloseButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close_overlay"
                android:src="@drawable/ic_close"
                app:tint="@color/stream_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- sound and vibration (long press on the volume button), just above the bar: the game's volume
             (0 % = muted) and, below, its vibration (tap the icon = on/off; 0 % = off) -->
        <LinearLayout
            android:id="@+id/volumePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/stream_picker_background"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/overlayBar">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/volumePickerIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_volume"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/stream_sound_button"
                    app:tint="@color/stream_text"/>

                <SeekBar
                    android:id="@+id/volumeSeekBar"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:max="100"/>

                <TextView
                    android:id="@+id/volumeValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/stream_text"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rumbleRow"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rumbleIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_rumble"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/stream_rumble_button"
                    app:tint="@color/stream_text"/>

                <SeekBar
                    android:id="@+id/rumbleSeekBar"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:max="200"/>

                <TextView
                    android:id="@+id/rumbleValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/stream_text"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- color preset picker (long press on Color): small and at the top, so most of the image
         stays visible while the presets are previewed live -->
    <LinearLayout
        android:id="@+id/presetPicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/stream_picker_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/presetPrevButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/preset_picker_previous"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/stream_text"/>

            <!-- tap to open the list; the arrow tells it is a drop-down -->
            <TextView
                android:id="@+id/presetName"
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:drawableEnd="@drawable/ic_arrow_drop_down"
                android:drawableTint="@color/stream_text"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:textColor="@color/stream_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/presetNextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/preset_picker_next"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/stream_text"/>
        </LinearLayout>

        <!-- drop-down list, about 4 rows tall so it covers little of the image -->
        <ScrollView
            android:id="@+id/presetList"
            android:layout_width="match_parent"
            android:layout_height="152dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/stream_picker_background"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scrollbarFadeDuration="0"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/presetListItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>

    <!-- editing the layout live (long press on the controls button): the same editor as in Settings -->
    <include
        android:id="@+id/padEditor"
        layout="@layout/view_pad_editor" />

</FrameLayout>