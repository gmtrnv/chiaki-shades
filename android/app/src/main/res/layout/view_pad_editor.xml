<?xml version="1.0" encoding="utf-8"?>
<!-- The touch pad's editor (layout bar, hint, options panel), shared by "Try the touch pad" and the
     live editor in the stream (phase 13). Touches on its empty space go through to what is under it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- scrolls sideways when it does not fit (small screens) -->
    <HorizontalScrollView
        android:id="@+id/editBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="#E6141418"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <CheckBox
                android:id="@+id/symmetricCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00E5FF"
                android:checked="true"
                android:text="@string/console_test_symmetric"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/editBarControls"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_layout_controls_button"
                android:textColor="#00E5FF" />

            <Button
                android:id="@+id/editBarSlots"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_layout_slots_button"
                android:textColor="#00E5FF" />

            <Button
                android:id="@+id/editBarOptions"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_test_options"
                android:textColor="#00E5FF" />

            <Button
                android:id="@+id/editBarReset"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_test_reset_layout"
                android:textColor="#00E5FF" />

            <Button
                android:id="@+id/editBarDone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_test_done"
                android:textColor="#00E5FF" />

            <Button
                android:id="@+id/editBarMove"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:contentDescription="@string/console_test_move_bar"
                android:text="▼"
                android:textColor="#00E5FF" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- editing the touchpad (double tap on the video) -->
    <HorizontalScrollView
        android:id="@+id/touchBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="#E6141418"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <Button
                android:id="@+id/touchBarTie"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/touch_edit_tied"
                android:textColor="#FF6FD8" />

            <Button
                android:id="@+id/touchBarFillVideo"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/touch_edit_fill_video"
                android:textColor="#FF6FD8" />

            <Button
                android:id="@+id/touchBarFillScreen"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/touch_edit_fill_screen"
                android:textColor="#FF6FD8" />

            <Button
                android:id="@+id/touchBarDone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/console_test_done"
                android:textColor="#FF6FD8" />

            <Button
                android:id="@+id/touchBarMove"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:contentDescription="@string/console_test_move_bar"
                android:text="▼"
                android:textColor="#FF6FD8" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/editHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:background="#B3000000"
        android:padding="8dp"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- a tap outside the options panel closes it -->
    <View
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F2141418"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</FrameLayout>
