<?xml version="1.0" encoding="utf-8"?>
<!-- What to export / import: one check box per block of the settings file (SerializedSettings.kt) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp">

        <CheckBox
            android:id="@+id/appCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_app" />

        <CheckBox
            android:id="@+id/imageCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_image" />

        <CheckBox
            android:id="@+id/consolesCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_consoles" />

        <!-- details of the consoles in the file (import only) -->
        <TextView
            android:id="@+id/consolesDetailsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:visibility="gone" />

        <TextView
            android:id="@+id/consolesWarningTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="#FFE53935"
            android:visibility="gone" />

        <TextView
            android:id="@+id/noteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
